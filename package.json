{
  "name": "conductivity",
  "version": "1.0.0",
  "author": "Conductivity",
  "description": "Minimalist 3-in-1 productivity app (Priority Matrix, Marble Jar, Focus Timer)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "build": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.conductivity.app",
    "productName": "Conductivity",
    "files": [
      "main.js",
      "server.js",
      "public/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

